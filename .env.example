# --- Application -----------------------------------------------------------
APP_ENV=dev
PORT=8080
LOG_LEVEL=info

# The API connects as the unprivileged application role. Superusers and
# BYPASSRLS roles ignore row-level security, so pointing this at the postgres
# superuser silently disables tenant isolation — the test suite asserts that the
# connected role is subject to policies, and will tell you if you do.
#
# The role is created by migrations/0001_init.sql. Production provisions it
# out-of-band with a secret-managed password.
DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/tenant_platform?sslmode=disable

# Owner credentials, used ONLY by `migrate up` and `migrate status`. The API
# never receives this value: it needs DDL rights that the application role
# deliberately does not have.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_platform?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# >= 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-32b-min

# --- Tests -----------------------------------------------------------------
# Database-backed tests fail (not skip) when this is unset: tenant-isolation
# assertions are the point of the suite, and a silently skipped suite is worse
# than a red build. Set SKIP_DB_TESTS=1 to run only the pure-unit subset.
TEST_DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/tenant_platform_test?sslmode=disable
TEST_MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_platform_test?sslmode=disable
# SKIP_DB_TESTS=1
