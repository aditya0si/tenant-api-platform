# --- Application -----------------------------------------------------------
APP_ENV=dev
PORT=8080
LOG_LEVEL=info

# The API connects as the unprivileged application role. Superusers and
# BYPASSRLS roles ignore row-level security, so pointing this at the postgres
# superuser silently disables tenant isolation — the test suite asserts that the
# connected role is subject to policies, and will tell you if you do.
#
# The role is created by migrations/0001_init.sql. Production provisions it
# out-of-band with a secret-managed password.
DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/tenant_platform?sslmode=disable

# Owner credentials, used ONLY by `migrate up` and `migrate status`. The API
# never receives this value: it needs DDL rights that the application role
# deliberately does not have.
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_platform?sslmode=disable

REDIS_URL=redis://localhost:6379/0

# --- Webhook delivery worker (cmd/worker) -----------------------------------
# The worker runs the same image as the API with a different entrypoint. It ignores JWT_SECRET
# and REDIS_URL: it authenticates no requests and enforces no rate limits, and leaving them
# unset here is what keeps that visible rather than implied.
#
# Its metrics and health listener. Kept off the API's port so a probe never lands on the wrong
# process, and not published in production: the outbox depth is operational data about every
# tenant's delivery backlog.
WORKER_METRICS_PORT=9090

# Rows claimed per poll. Bounded because one slow receiver must not hold a whole backlog — each
# claimed row is held for the duration of its attempt.
WORKER_BATCH_SIZE=10

# Poll interval when nothing is due. Claimed work is settled as soon as it completes, so this is
# the idle cadence rather than the delivery latency.
WORKER_INTERVAL=1s

# Networks whose forwarding headers (X-Forwarded-For, Forwarded) may be believed, as a
# comma-separated list of CIDRs. A bare address is read as a single host.
#
# Empty means "trust nothing": every request is attributed to its socket address, which a
# caller cannot forge. That is the safe default and the right one, because both ways of
# getting it wrong are silent — an unconfigured proxy makes every client share one
# rate-limit bucket and throttle each other, while believing headers from an untrusted peer
# gives anyone a limiter they bypass with one extra header.
#
# Set this only when the service is unreachable except through those proxies.
TRUSTED_PROXY_CIDRS=

# >= 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=dev-only-insecure-secret-change-me-32b-min

# --- Tests -----------------------------------------------------------------
# Database-backed tests fail (not skip) when this is unset: tenant-isolation
# assertions are the point of the suite, and a silently skipped suite is worse
# than a red build. Set SKIP_DB_TESTS=1 to run only the pure-unit subset.
TEST_DATABASE_URL=postgres://app_rw:app_rw@localhost:5432/tenant_platform_test?sslmode=disable
TEST_MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tenant_platform_test?sslmode=disable
# SKIP_DB_TESTS=1

# Redis backs the rate limiter. A separate logical database from the development one, so a
# test run cannot throttle a server someone is using. Tests fail (not skip) when this is
# unset, for the same reason the database tests do.
TEST_REDIS_URL=redis://localhost:6379/1
